  "grammar1/gh1-054#38": {
   "id": "grammar1/gh1-054#38",
   "시험": [
    {
     "답": "Wasn't there any water",
     "점수": "만점"
    },
    {
     "답": "Was there not any water?",
     "점수": "70점"
    },
    {
     "답": "Was there not water",
     "점수": "만점"
    },
    {
     "답": "Wasn't there some water?",
     "점수": "70점"
    },
    {
     "답": "Was there no water?",
     "점수": "70점"
    }
   ],
   "막힘": [
    {
     "답": "Was there not any water?",
     "점수": "70점",
     "심각도": "낮음",
     "까닭": "이 문항이 이미 만점으로 받는 다른 정답 'Wasn't there any water?' 와 낱말까지 같은 답의 줄이지 않은 꼴(wasn't ↔ was … not) — 소유자 결정 2 의 '기능어 하나 더' 가 아니라 줄임꼴 차이. 채점이 wasn't 를 'was not' 으로 펴 'was not there any water' 와 어순이 달라져 70점. 이 문항은 줄이지 않은 'Was there not water?' 를 따로 만점으로 받는데 any 꼴에만 그 짝이 없음. 맞는 영어 · 부정 의문 꼴 지킴. 새 다른 정답 'Was there not any water?'(모의 만점 · 'Was there any water?' 는 0점 그대로)",
     "확신": "보통"
    }
   ],
   "안적음": [
    {
     "답": "Wasn't there some water?",
     "점수": "70점",
     "까닭": "기능어 some 하나 더(다른 정답 any 와도 기능어 하나 차이) — 소유자 결정 2 로 70점"
    },
    {
     "답": "Was there no water?",
     "점수": "70점",
     "까닭": "'물이 없었나?'(없음을 확인하는 물음)의 번역 — 한국어 '있지 않았나?' 는 있었으리라 여기고 묻는 부정 의문(Wasn't there …?)이라 뜻 결이 다르고, 이 강의가 가르치는 not 부정 의문 꼴을 no 로 피함. 70점이면 됨"
    }
   ],
   "때": "2026-09-25 00:10"
  },

# Public URLs
NEXT_PUBLIC_SITE_URL=https://k-ig-core.vercel.app
NEXT_PUBLIC_MEDIA_URL=https://your-public-media-domain.example
NEXT_PUBLIC_PURCHASE_URL=https://your-store-product-page.example

# Server-only secrets. Generate unique random values for every deployment.
# Never copy example or previously published values into production.
ADMIN_PIN=replace-me-with-a-unique-admin-pin
ADMIN_SESSION_SECRET=replace-me-with-at-least-32-random-characters
LICENSE_SALT=replace-me-with-at-least-32-random-characters
LICENSE_SECRET=replace-me-with-at-least-32-random-characters
LICENSE_STORAGE_SECRET=replace-me-with-at-least-32-random-characters

# Durable license/device storage (Cloudflare R2 S3 credentials)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_LICENSE_BUCKET=your-private-r2-bucket-name

  "readingSentences": [
    {
      "id": "reading-231-s001",
      "english": "Would a modern music composer be your first choice for a hero?",
      "korean": "당신은 현대 음악 작곡가를 당신의 첫 번째 영웅으로 선택하겠는가?"
    },
    {
      "id": "reading-231-s002",
      "english": "Or would you think of the painter of a contemporary masterpiece?",
      "korean": "혹은 동시대 걸작을 그린 화가를 생각하겠는가?"
    },
    {
      "id": "reading-231-s003",
      "english": "If you are like most people, the answer to both questions is “no.”",
      "korean": "당신이 대부분의 사람들과 같다면, 두 질문에 대한 대답은 “아니요”이다."
    },
    {
      "id": "reading-231-s004",
      "english": "More likely, a sports hero or a movie star would be your first choice.",
      "korean": "그보다는 스포츠 영웅이나 영화배우가 당신의 첫 번째 선택일 것이다."
    },
    {
      "id": "reading-231-s005",
      "english": "It seems that the worlds of contemporary art and music have failed to offer people works that reflect human achievements.",
      "korean": "현대 미술과 음악의 세계는 인간의 성취를 반영하는 작품을 사람들에게 제공하지 못하고 있는 것 같다."
    },
    {
      "id": "reading-231-s006",
      "english": "People, therefore, have lost interest in modern arts and have turned to sports stars and other popular figures to find their role models.",
      "korean": "따라서 사람들은 현대 예술에 대한 흥미를 잃고 자신의 역할 모델을 찾기 위해 스포츠 스타나 다른 대중적인 인물들에게 눈을 돌리고 있다."
    }
  ],

  "readingSentences": [
    {
      "id": "reading-131-s001",
      "english": "Patience and perseverance are the keys to mastering any difficult endeavor.",
      "korean": "인내와 끈기는 그 어떤 어려운 일이라도 통달할 수 있게 해주는 열쇠이다."
    },
    {
      "id": "reading-131-s002",
      "english": "Immediate success is rare in any creative or professional field.",
      "korean": "창의적이거나 전문적인 분야에서 즉각적인 성공은 매우 드물다."
    },
    {
      "id": "reading-131-s003",
      "english": "Those who achieve greatness are those who persist through repeated failures.",
      "korean": "위대함을 달성하는 사람들은 거듭되는 실패 속에서도 끈기 있게 지속하는 이들이다."
    },
    {
      "id": "reading-131-s004",
      "english": "Resilience in the face of setbacks transforms ordinary effort into extraordinary talent.",
      "korean": "좌절에 굴하지 않는 회복탄력성이 평범한 노력을 비범한 재능으로 변화시킨다."
    }
  ],

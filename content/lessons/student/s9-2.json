  "chunkDrills": [
    {
      "ko": "나는 점심을 먹는다.",
      "en": "I have lunch"
    },
    {
      "ko": "점심식사 후에",
      "en": "After lunch,"
    },
    {
      "ko": "나는 두개 이상의 수업을 가지고 있다.",
      "en": "I have two more classes."
    },
    {
      "ko": "나는 내 수업을 마친다.",
      "en": "I finish my classes"
    },
    {
      "ko": "방과후에",
      "en": "After school,"
    },
    {
      "ko": "나는 학원에 간다.",
      "en": "I go to private academies"
    },
    {
      "ko": "나는 그 곳에서 공부한다.",
      "en": "where I study"
    },
    {
      "ko": "미술, 피아노, 그리고 영어를",
      "en": "Art, Piano and English."
    },
    {
      "ko": "각각의 학원수업은",
      "en": "Each academy lesson"
    },
    {
      "ko": "때때로 나는 매우 피곤하다.",
      "en": "Sometimes I get very tired"
    },
    {
      "ko": "내가 학원에 있을 때",
      "en": "when I'm at the academies,"
    },
    {
      "ko": "그러나 나는 공부하는 것을 즐긴다.",
      "en": "but I enjoy studying"
    },
    {
      "ko": "나의 친구들과 그곳에서",
      "en": "with my friends there."
    },
    {
      "ko": "내 마지막 학원 수업 후에",
      "en": "After my last academy class,"
    },
    {
      "ko": "나는 집에 도착한다.",
      "en": "I get home"
    }
  ]
}

  "chunkDrills": [
    {
      "ko": "나는 조금 논 후",
      "en": "After I play a little,"
    },
    {
      "ko": "해야만 한다.",
      "en": "I have to do"
    },
    {
      "ko": "나의 모든 숙제를",
      "en": "all of my homework."
    },
    {
      "ko": "만약 내가 숙제를 이해하지 못한다면",
      "en": "If I can't figure out my homework,"
    },
    {
      "ko": "나는 항상 찾아볼 수 있다.",
      "en": "I can always look"
    },
    {
      "ko": "인터넷 상에서",
      "en": "on the Internet."
    },
    {
      "ko": "나는 종종 답을 찾는다.",
      "en": "I oftentimes find the answers"
    },
    {
      "ko": "내 숙제에 대한",
      "en": "to my assignments"
    },
    {
      "ko": "월드 와이드 웹에서",
      "en": "on the World Wide Web."
    },
    {
      "ko": "나는 빨리 피곤해 진다.",
      "en": "I get very tired quickly"
    },
    {
      "ko": "왜냐하면 나는 숙제를 해야하기 때문에",
      "en": "because I have to do homework"
    },
    {
      "ko": "학원과 학교 두군데로부터 온",
      "en": "from both the academies and school."
    },
    {
      "ko": "비록 내가 피곤하다 할지라도",
      "en": "Even though I am tired,"
    },
    {
      "ko": "나는 계속 공부한다.",
      "en": "I keep studying"
    },
    {
      "ko": "왜냐하면 나는 새로운 것을 배우기를 즐기기 때문에",
      "en": "because I enjoy learning new things."
    }
  ]
}

  "chunkDrills": [
    {
      "ko": "그의 아이들이 동갑이고",
      "en": "his children are the same age"
    },
    {
      "ko": "우리의 가족은 종종 방문합니다.",
      "en": "Our family often visits"
    },
    {
      "ko": "내 아버지의 친구 집을",
      "en": "the house of my father's friend."
    },
    {
      "ko": "우리는 때때로",
      "en": "We sometimes"
    },
    {
      "ko": "우리의 친척들을 방문합니다.",
      "en": "visit our relatives"
    },
    {
      "ko": "또는 그들이 옵니다.",
      "en": "or they come"
    },
    {
      "ko": "우리의 집에",
      "en": "to our house."
    },
    {
      "ko": "나는 방문하기를 좋아합니다.",
      "en": "I like visiting"
    },
    {
      "ko": "나의 친척들을",
      "en": "my relatives"
    },
    {
      "ko": "일요일 오후에",
      "en": "on Sunday afternoons."
    },
    {
      "ko": "보는 것이 좋습니다.",
      "en": "It's nice to see"
    },
    {
      "ko": "그들이 어떻게 지내는 가를",
      "en": "how they are doing."
    },
    {
      "ko": "나는 또한 방문하기를 좋아합니다.",
      "en": "I also like to visit"
    },
    {
      "ko": "왜냐하면",
      "en": "because"
    },
    {
      "ko": "그리고 우리는 항상",
      "en": "and we always"
    },
    {
      "ko": "즐거움을 가집니다.",
      "en": "have great fun"
    },
    {
      "ko": "우리의 시간을 보내면서",
      "en": "spending our time"
    },
    {
      "ko": "함께",
      "en": "together."
    }
  ]
}

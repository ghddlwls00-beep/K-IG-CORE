  "chunkDrills": [
    {
      "ko": "보통 수업시간에",
      "en": "Usually in class,"
    },
    {
      "ko": "학생들은 매우 친하다.",
      "en": "the students are very friendly"
    },
    {
      "ko": "서로서로에게",
      "en": "to each other."
    },
    {
      "ko": "그러나 때때로 있을 수 있다.",
      "en": "However, sometimes there can be"
    },
    {
      "ko": "학급 친구들 사이에서 싸움과 언쟁이",
      "en": "fights and arguments between classmates."
    },
    {
      "ko": "대부분의 학생들은",
      "en": "Most of the students"
    },
    {
      "ko": "빨리 화해한다.",
      "en": "quickly make up"
    },
    {
      "ko": "그리고 다시 친구가 된다.",
      "en": "and are friends again."
    },
    {
      "ko": "우리 반은 가졌기 때문에",
      "en": "Because our class has"
    },
    {
      "ko": "많은 똑똑한 학생들을 그 안에",
      "en": "a lot of smart students in it,"
    },
    {
      "ko": "우리는 매우 경쟁심이 강하다",
      "en": "we are very competitive."
    },
    {
      "ko": "학교에서",
      "en": "At school,"
    },
    {
      "ko": "나는 공부하고 친구사귀기를 좋아한다.",
      "en": "I like to study and make friends."
    }
  ]
}

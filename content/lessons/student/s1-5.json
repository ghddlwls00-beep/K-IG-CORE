  "chunkDrills": [
    {
      "ko": "나는 많은 다른 과목들을 공부합니다.",
      "en": "I study many different subjects"
    },
    {
      "ko": "(유치원에서) 학교에서",
      "en": "at (kindergarten) school,"
    },
    {
      "ko": "그러나 나의 가장 좋아하는 과목은 영어입니다.",
      "en": "but my favorite subject is English."
    },
    {
      "ko": "나는 영어를 공부해 왔습니다.",
      "en": "I have been studying English"
    },
    {
      "ko": "나는 영어공부하기를 좋아합니다",
      "en": "I like studying English"
    },
    {
      "ko": "왜냐하면 그것은 재미있고 흥미롭기 때문입니다",
      "en": "because it is fun and exciting"
    },
    {
      "ko": "배우기에",
      "en": "to learn."
    }
  ]

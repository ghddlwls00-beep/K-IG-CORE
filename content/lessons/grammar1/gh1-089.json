      "text": "영작문제 1 답안"
    },
    {
      "type": "instruction",
      "text": "다음 문제를 영작해주세요."
    },
    {
      "type": "sentences",
      "items": [
        {
          "n": "1",
          "text": "Is this your homework?",
          "alternatives": [
            "Is this your assignment?",
            "Is this your task?",
            "Is this your project?"
          ]
        },
        {
          "n": "2",
          "text": "Is this prize yours?",
          "alternatives": [
            "Is this award yours?"
          ]
        },
        {
          "n": "3",
          "text": "Is your professor healthy?",
          "alternatives": [
            "Is your professor well?",
            "Is your professor in good health?"
          ]
        },
        {
          "n": "4",
          "text": "Whose employees are these girls?"
        },
        {
          "n": "5",
          "text": "Are they police officers?",
          "alternatives": [
            "Are they policemen?",
            "Are they police?"
          ]
        },
        {
          "n": "6",
          "text": "Is your employer unhappy?",
          "alternatives": [
            "Is your employer upset?",
            "Is your employer in a bad mood?"
          ]
        },
        {
          "n": "7",
          "text": "Is the ring yours?"
        },
        {
          "n": "8",
          "text": "Are these gentlemen your clients?",
          "alternatives": [
            "Are these gentlemen your customers?"
          ]
        },
        {
          "n": "9",
          "text": "Whose fatherland is this?",
          "alternatives": [
            "Whose homeland is this?",
            "Whose motherland is this?",
            "Whose home country is this?",
            "Whose native country is this?"
          ]
        },
        {
          "n": "10",
          "text": "Where am I?"
        },
        {
          "n": "11",
          "text": "Is it warm today?"
        },
        {
          "n": "12",
          "text": "She is not that smart.",
          "alternatives": [
            "She is not so smart.",
            "She is not that clever.",
            "She is not that intelligent."
          ]
        },
        {
          "n": "13",
          "text": "Was the general brave?",
          "alternatives": [
            "Was the general courageous?"
          ]
        },
        {
          "n": "14",
          "text": "Where are the ministers today?"
        },
        {
          "n": "15",
          "text": "The microphone is still on.",
          "alternatives": [
            "The mike is still on.",
            "The mic is still on.",
            "The microphone is still turned on.",
            "The mic is still turned on.",
            "The microphone is still switched on."
          ]
        },
        {
          "n": "16",
          "text": "Where were the politicians?",
          "alternatives": [
            "Where were the statesmen?"
          ]
        },
        {
          "n": "17",
          "text": "Was the congressman unhappy?",
          "alternatives": [
            "Was the lawmaker unhappy?",
            "Was the congresswoman unhappy?",
            "Was the legislator unhappy?",
            "Was the assemblyman unhappy?",
            "Was the MP unhappy?"
          ]
        },
        {
          "n": "18",
          "text": "Whose decision was this?",
          "alternatives": [
            "Whose was this decision?"
          ]
        },
        {
          "n": "19",
          "text": "Was it hot yesterday?"
        }
      ]

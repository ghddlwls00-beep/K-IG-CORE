      "text": "영작문제 5 답안"
    },
    {
      "type": "instruction",
      "text": "다음 문제를 영작해주세요."
    },
    {
      "type": "sentences",
      "items": [
        {
          "n": "1",
          "text": "Who did this?"
        },
        {
          "n": "2",
          "text": "What does he want?"
        },
        {
          "n": "3",
          "text": "What can he do for me?"
        },
        {
          "n": "4",
          "text": "Why is she sitting there?"
        },
        {
          "n": "5",
          "text": "When does he come here?",
          "alternatives": [
            "When is he coming here?"
          ]
        },
        {
          "n": "6",
          "text": "Whose car is that?",
          "alternatives": [
            "Whose car is it?"
          ]
        },
        {
          "n": "7",
          "text": "Whose pencils are those?",
          "alternatives": [
            "Whose pencils are they?"
          ]
        },
        {
          "n": "8",
          "text": "Whom does he love?",
          "alternatives": [
            "Who does he love?"
          ]
        },
        {
          "n": "9",
          "text": "Who loves her?"
        },
        {
          "n": "10",
          "text": "Which book does she want?"
        },
        {
          "n": "11",
          "text": "Which does his mother want?",
          "alternatives": [
            "Which one does his mother want?"
          ]
        },
        {
          "n": "12",
          "text": "That is your car, isn't it?",
          "alternatives": [
            "It is your car, isn't it?"
          ]
        },
        {
          "n": "13",
          "text": "He loves her, doesn't he?"
        },
        {
          "n": "14",
          "text": "He doesn't have breakfast, does he?",
          "alternatives": [
            "He doesn't eat breakfast, does he?"
          ]
        },
        {
          "n": "15",
          "text": "She didn't have dinner, did she?",
          "alternatives": [
            "She didn't eat dinner, did she?"
          ]
        },
        {
          "n": "16",
          "text": "He needs much water, doesn't he?",
          "alternatives": [
            "He needs a lot of water, doesn't he?",
            "He needs lots of water, doesn't he?"
          ]
        },
        {
          "n": "17",
          "text": "The hospital wants much blood, doesn't it?",
          "alternatives": [
            "The hospital wants a lot of blood, doesn't it?",
            "The hospital wants lots of blood, doesn't it?"
          ]
        },
        {
          "n": "18",
          "text": "He is a gentleman, isn't he?"
        },
        {
          "n": "19",
          "text": "He wants apples.",
          "alternatives": [
            "He wants an apple.",
            "He wants some apples."
          ]

              "start": 91,
              "end": 101,
              "choices": [
                "imprisoned",
                "tortured",
                "showcase"
              ]
            },
            {
              "word": "freedom of speech",
              "say": "freedom of speech",
              "meaning": "표현의 자유",
              "pos": "명사",
              "start": 102,
              "end": 119,
              "choices": [
                "political assembly",
                "repression",
                "voter turnout"
              ]
            },
            {
              "word": "political assembly",
              "say": "political assembly",
              "meaning": "정치 집회",
              "pos": "명사",
              "start": 136,

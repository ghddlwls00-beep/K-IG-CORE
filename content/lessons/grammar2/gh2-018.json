          ]
        },
        {
          "n": "3",
          "text": "Here is a problem.",
          "alternatives": [
            "Here is one problem."
          ]
        },
        {
          "n": "4",
          "text": "There was a boy.",
          "alternatives": [
            "There was one boy."
          ]
        },
        {
          "n": "5",
          "text": "There was a boy there.",
          "alternatives": [
            "There was one boy there."
          ]
        },
        {
          "n": "6",
          "text": "He succeeded in it.",
          "alternatives": [
            "He succeeded in that.",

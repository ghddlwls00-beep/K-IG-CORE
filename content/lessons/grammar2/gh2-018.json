        {
          "n": "9",
          "text": "She is suffering from a headache."
        },
        {
          "n": "10",
          "text": "The company suffered a heavy loss.",
          "alternatives": [
            "The company suffered a big loss.",
            "The company suffered a large loss.",
            "The company suffered a great loss."
          ]
        },
        {
          "n": "11",
          "text": "You must change your evil ways.",
          "alternatives": [
            "You have to change your evil ways.",
            "You should change your evil ways.",
            "You must change your wicked ways."
          ]
        },
        {
          "n": "12",
          "text": "You've changed a lot since I saw you last.",
          "alternatives": [
            "You've changed much since I saw you last.",
            "You have changed a lot since I last saw you.",
            "You've changed a lot since the last time I saw you."
          ]
        },
        {
          "n": "13",
          "text": "The members opposed the plan.",
          "alternatives": [
            "The members objected to the plan.",
            "The members were opposed to the plan.",
            "The plan was opposed by the members."
          ]
        },
        {
          "n": "14",
          "text": "The plant grows fast.",
          "alternatives": [
            "The plant grows quickly."
          ]
        },
        {
          "n": "15",
          "text": "It grew dark."
        },
        {
          "n": "16",
          "text": "He grew a beard."
        },
        {
          "n": "17",
          "text": "I took her by the arm.",
          "alternatives": [
            "I took her by the arms.",
            "I grabbed her by the arm.",
            "I caught her by the arm."
          ]
        },
        {
          "n": "18",
          "text": "I held her in my arms."
        },
        {
          "n": "19",
          "text": "Don't hold me like that.",
          "alternatives": [
            "Don't hold me that way."

      "items": [
        {
          "n": "1",
          "text": "I will pick up the tab.",
          "alternatives": [
            "I'll pick up the check.",
            "I'll pick up the bill."
          ]
        },
        {
          "n": "2",
          "text": "This is on me.",
          "alternatives": [
            "This one's on me."
          ]
        },
        {
          "n": "3",
          "text": "I'm buying today.",
          "alternatives": [
            "Today I'm buying."
          ]
        },
        {
          "n": "4",
          "text": "It's my treat.",
          "alternatives": [
            "It's on me.",
            "I'm treating.",
            "This is my treat."
          ]
        },
        {
          "n": "5",
          "text": "Let's go Dutch."
        },
        {
          "n": "6",
          "text": "Waiter, will you take our order?",
          "alternatives": [
            "Waiter, would you take our order?",
            "Waiter, could you take our order?"
          ]
        },
        {
          "n": "7",
          "text": "What does your husband do for a living?"
        },
        {
          "n": "8",
          "text": "What is your husband doing?"
        },
        {
          "n": "9",
          "text": "It fits you perfectly.",
          "alternatives": [
            "That fits you perfectly.",
            "It perfectly fits you."
          ]
        },
        {
          "n": "10",
          "text": "He is a Korean by birth but an American by citizenship.",
          "alternatives": [
            "He is Korean by birth but American by citizenship.",
            "He is Korean by birth but American by nationality.",
            "He is a Korean by birth but an American by nationality."
          ]
        },
        {
          "n": "11",
          "text": "He is a naturalized citizen.",
          "alternatives": [
            "He is a naturalised citizen."
          ]
        },
        {
          "n": "12",
          "text": "What seems to be the problem?",
          "alternatives": [
            "What seems to be the trouble?",
            "What seems to be the matter?"
          ]
        },
        {
          "n": "13",
          "text": "I am afraid I have a cavity.",
          "alternatives": [
            "I'm afraid I've got a cavity."
          ]
        },
        {
          "n": "14",
          "text": "Do you think he will forget us once he becomes rich and famous?",
          "alternatives": [
            "Do you think he'll forget us once he gets rich and famous?",
            "Do you think he will forget us once he becomes wealthy and famous?",
            "Do you think he is going to forget us once he becomes rich and famous?"
          ]
        },
        {
          "n": "15",
          "text": "I'm afraid so."
        },
        {
          "n": "16",
          "text": "I hope not."
        },
        {
          "n": "17",
          "text": "You look familiar.",
          "alternatives": [
            "You seem familiar."
          ]
        },
        {
          "n": "18",
          "text": "Do I know you?"
        },
        {
          "n": "19",
          "text": "You have a very good memory.",
          "alternatives": [
            "You've got a very good memory.",
            "You have a really good memory."
          ]
        },
        {
          "n": "20",
          "text": "Do you recognize me?",
          "alternatives": [
            "Can you recognize me?",
            "Do you recognise me?",
            "Can you recognise me?"
          ]
        },
        {
          "n": "21",
          "text": "Do you have company?",
          "alternatives": [
            "Have you got company?"
          ]
        },
        {
          "n": "22",
          "text": "Do you have a company?",
          "alternatives": [
            "Do you own a company?",
            "Have you got a company?"
          ]
        },
        {
          "n": "23",
          "text": "How do you spell your name?"
        },
        {
          "n": "24",
          "text": "Call me Bill."
        },
        {
          "n": "25",
          "text": "Don't sir me."
        },
        {
          "n": "26",
          "text": "Don't mister me."
        }
      ]
